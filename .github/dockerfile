FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build_test_publish

WORKDIR /src

# Copy project files first for better layer caching during restore.
# Copy project file for layer-cached restore.
COPY src/CsharpAppBuildDocker.Api/CsharpAppBuildDocker.Api.csproj src/CsharpAppBuildDocker.Api/

# Restore NuGet packages for the project (creates obj/project.assets.json).
RUN dotnet restore src/CsharpAppBuildDocker.Api/CsharpAppBuildDocker.Api.csproj

# Copy full source after restore.
COPY . .

# 3) Build application and tests.
RUN dotnet build src/CsharpAppBuildDocker.Api/CsharpAppBuildDocker.Api.csproj -c Release --no-restore 

# 5) Publish application and keep build artifacts.
RUN dotnet publish src/CsharpAppBuildDocker.Api/CsharpAppBuildDocker.Api.csproj \
	-c Release \
	--no-build \
	-o /artifacts/publish

RUN mkdir -p /artifacts/build/api \
	&& cp -R src/CsharpAppBuildDocker.Api/bin/Release/net8.0/. /artifacts/build/api/ 

# 6) Create busybox image carrying build and coverage artifacts.
FROM busybox:1.36 AS busybox_artifacts

WORKDIR /artifacts

COPY --from=build_test_publish /artifacts/build ./build
COPY --from=build_test_publish /artifacts/publish ./publish

CMD ["sh", "-c", "echo Artifacts available under /artifacts; find /artifacts -maxdepth 4 -type f | sort"]

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

RUN apt-get update && \
    apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*
	

WORKDIR /app

# Copy published output from the build stage
COPY --from=build_test_publish /artifacts/publish/. /app

ENTRYPOINT ["dotnet", "CsharpAppBuildDocker.Api.dll"]
